# ---- Base de datos (libSQL) ----
# Local: se usa un archivo en .data/ si no defines nada.
# Producción (Vercel): crea una base en https://turso.tech y pega aquí sus datos.
DATABASE_URL=file:.data/velocita.db
DATABASE_AUTH_TOKEN=

# ---- Imágenes ----
# Producción en Vercel: crea un Blob Store (Storage > Blob) y Vercel añade este token solo.
# Si está vacío, las fotos se guardan en .data/uploads (solo sirve en local / servidor propio).
BLOB_READ_WRITE_TOKEN=

# ---- Primer administrador (solo se usa cuando la base está vacía) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-clave
ADMIN_NAME=Administrador

# Cargar los 5 vehículos de ejemplo la primera vez (true/false)
SEED_DEMO=true
