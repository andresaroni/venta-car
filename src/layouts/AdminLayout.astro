---
import '../styles/global.css';
import '../styles/admin.css';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  section: 'resumen' | 'inventario' | 'equipo' | 'cuenta';
}

const { title, section } = Astro.props;
const user = Astro.locals.user!;
const isAdmin = user.role === 'admin';

const nav = [
  { id: 'resumen', href: '/admin/resumen', label: 'Resumen', icon: 'grid' },
  { id: 'inventario', href: '/admin/inventario', label: 'Inventario', icon: 'car' },
  ...(isAdmin ? [{ id: 'equipo', href: '/admin/equipo', label: 'Equipo', icon: 'users' }] : []),
  { id: 'cuenta', href: '/admin/cuenta', label: 'Mi cuenta', icon: 'key' },
];

const icons: Record<string, string> = {
  grid: '<rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/>',
  car: '<path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/>',
  users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  key: '<path d="m15.5 7.5 2.3 2.3a1 1 0 0 0 1.4 0l2.1-2.1a1 1 0 0 0 0-1.4L19 4"/><path d="m21 2-9.6 9.6"/><circle cx="7.5" cy="15.5" r="5.5"/>',
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700;800;900&family=DM+Sans:wght@400;500;600;700&display=swap"
    />
    <title>{title} · Velocita Admin</title>
  </head>
  <body class="admin-body">
    <div class="shell">
      <aside class="sidebar" data-sidebar>
        <a href="/admin/resumen" class="sidebar-logo" aria-label="Inicio del panel"><Logo /></a>
        <nav class="sidebar-nav" aria-label="Panel">
          {
            nav.map((item) => (
              <a href={item.href} class:list={['nav-link', { active: section === item.id }]} aria-current={section === item.id ? 'page' : undefined}>
                <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[item.icon]} />
                {item.label}
              </a>
            ))
          }
        </nav>
        <div class="sidebar-foot">
          <a href="/" target="_blank" rel="noopener" class="view-site">
            Ver sitio público
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
          </a>
          <div class="me">
            <p class="me-name">{user.name}</p>
            <p class="me-role">{isAdmin ? 'Administrador' : 'Vendedor'}</p>
          </div>
          <form method="post" action="/api/auth/logout">
            <button class="signout" type="submit">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" x2="9" y1="12" y2="12"></line></svg>
              Cerrar sesión
            </button>
          </form>
        </div>
      </aside>
      <div class="sidebar-scrim" data-sidebar-scrim></div>

      <div class="content">
        <header class="topbar">
          <button class="a-icon-btn menu-toggle" type="button" aria-label="Abrir menú" data-sidebar-toggle>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16"></path><path d="M4 12h16"></path><path d="M4 19h16"></path></svg>
          </button>
          <div>
            <p class="a-eyebrow">{title}</p>
            <p class="greeting"><span data-greeting>Hola</span>, {user.name.split(' ')[0]}</p>
          </div>
          <form method="post" action="/api/auth/logout" class="topbar-out">
            <button class="a-icon-btn" type="submit" aria-label="Cerrar sesión" title="Cerrar sesión">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" x2="9" y1="12" y2="12"></line></svg>
            </button>
          </form>
        </header>

        <main class="page">
          <slot />
        </main>
      </div>
    </div>

    <dialog class="a-modal narrow" id="confirm-dialog" aria-labelledby="confirm-title">
      <div class="a-modal-body">
        <div>
          <p class="a-eyebrow red">Confirmar</p>
          <h2 class="a-title a-h3" id="confirm-title" data-confirm-title style="margin-top:.5rem"></h2>
          <p class="a-lead" data-confirm-message></p>
        </div>
        <div class="confirm-actions">
          <button type="button" class="a-btn a-btn-ghost" data-close>Cancelar</button>
          <button type="button" class="a-btn a-btn-primary" data-confirm-ok>Eliminar</button>
        </div>
      </div>
    </dialog>

    <style>
      .shell {
        min-height: 100vh;
      }
      .sidebar {
        position: fixed;
        inset: 0 auto 0 0;
        z-index: 40;
        display: flex;
        flex-direction: column;
        width: 16rem;
        padding: 1.75rem 1.25rem 1.5rem;
        background: var(--a-sidebar);
        color: #fff;
        transform: translateX(-100%);
        transition: transform 0.25s ease;
        overflow-y: auto;
      }
      .sidebar.open {
        transform: none;
      }
      .sidebar-scrim {
        position: fixed;
        inset: 0;
        z-index: 39;
        background: rgb(0 0 0 / 0.5);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s ease;
      }
      .sidebar.open + .sidebar-scrim {
        opacity: 1;
        pointer-events: auto;
      }
      .sidebar-logo {
        display: block;
        padding-inline: 0.25rem;
      }
      .sidebar-nav {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        margin-top: 3rem;
      }
      .nav-link {
        display: flex;
        align-items: center;
        gap: 0.875rem;
        padding: 0.875rem 1rem;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgb(255 255 255 / 0.6);
        transition: color 0.2s ease, background-color 0.2s ease;
      }
      .nav-link:hover {
        color: #fff;
        background: rgb(255 255 255 / 0.05);
      }
      .nav-link.active {
        background: var(--red);
        color: #fff;
      }
      .sidebar-foot {
        margin-top: auto;
        padding-top: 1.5rem;
        border-top: 1px solid rgb(255 255 255 / 0.1);
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
      .view-site {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: rgb(255 255 255 / 0.55);
      }
      .view-site:hover {
        color: #fff;
      }
      .me-name {
        font-size: 14px;
        font-weight: 700;
      }
      .me-role {
        margin-top: 0.25rem;
        font-size: 10px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgb(255 255 255 / 0.45);
      }
      .signout {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 13px;
        color: rgb(255 255 255 / 0.6);
      }
      .signout:hover {
        color: #fff;
      }

      .topbar {
        position: sticky;
        top: 0;
        z-index: 30;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem var(--gutter);
        background: #fff;
        border-bottom: 1px solid var(--a-line);
      }
      .greeting {
        margin-top: 0.25rem;
        font-family: var(--font-condensed);
        font-size: 1.625rem;
        font-weight: 800;
        line-height: 1;
        text-transform: uppercase;
      }
      .topbar-out {
        margin-left: auto;
      }
      .page {
        padding: 2.5rem var(--gutter) 4rem;
        max-width: 96rem;
      }
      .confirm-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
      }

      @media (min-width: 1024px) {
        .sidebar {
          transform: none;
        }
        .sidebar-scrim,
        .menu-toggle {
          display: none;
        }
        .content {
          margin-left: 16rem;
        }
        .topbar {
          padding-block: 1.25rem;
        }
        .greeting {
          font-size: 2rem;
        }
        .page {
          padding-top: 3rem;
        }
      }
    </style>

    <script>
      import { flushToast, wireDialogs } from '../scripts/admin';

      const h = new Date().getHours();
      const greet = h < 12 ? 'Buenos días' : h < 19 ? 'Buenas tardes' : 'Buenas noches';
      document.querySelectorAll('[data-greeting]').forEach((el) => (el.textContent = greet));

      const sidebar = document.querySelector('[data-sidebar]');
      document.querySelector('[data-sidebar-toggle]')?.addEventListener('click', () => sidebar?.classList.add('open'));
      document.querySelector('[data-sidebar-scrim]')?.addEventListener('click', () => sidebar?.classList.remove('open'));

      wireDialogs();
      flushToast();
    </script>
  </body>
</html>
