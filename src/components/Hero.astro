---
import Logo from './Logo.astro';
import { site, whatsappLink } from '../data/site';

interface Props {
  count: number;
}
const { count } = Astro.props;
const heroImage =
  'https://images.unsplash.com/photo-1542362567-b07e54358753?auto=format&fit=crop&w=2200&q=90';
---

<section class="hero">
  <img class="hero-bg" src={heroImage} alt="Sports car on a winding road" fetchpriority="high" />
  <div class="hero-shade"></div>

  <header class="hero-header">
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-open>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16"></path><path d="M4 12h16"></path><path d="M4 19h16"></path></svg>
      MENU
    </button>
    <Logo />
  </header>

  <div class="hero-content">
    <p class="hero-eyebrow">Curated automotive excellence</p>
    <h1 class="hero-title">Drive<br /><span class="text-red">different.</span></h1>
    <div class="hero-actions">
      <a href="#inventory" class="hero-cta">
        Explore collection
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7 7 10 10"></path><path d="M17 7v10H7"></path></svg>
      </a>
      <span class="hero-count">{count} vehicles ready for their next chapter</span>
    </div>
  </div>
</section>

<!-- Menú a pantalla completa -->
<div class="menu" id="site-menu" hidden>
  <div class="menu-top">
    <button class="menu-btn" type="button" data-menu-close>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
      CLOSE
    </button>
    <Logo />
  </div>
  <nav class="menu-nav" aria-label="Main">
    <a href="#inventory" data-menu-link><span>01</span>The collection</a>
    <a href="#contact" data-menu-link><span>02</span>Contact</a>
    <a href={whatsappLink(site.contactMessage)} target="_blank" rel="noopener" data-menu-link>
      <span>03</span>WhatsApp
    </a>
  </nav>
</div>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 680px;
    overflow: hidden;
    background: #000;
    color: #fff;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.65;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgb(0 0 0 / 0.85), rgb(0 0 0 / 0.3), transparent);
  }
  .hero-header {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.75rem var(--gutter);
  }
  .menu-btn {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 12px;
    letter-spacing: 0.24em;
    color: #fff;
  }
  .hero-content {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 570px;
    max-width: var(--container);
    padding: 0 var(--gutter) 4rem;
  }
  .hero-eyebrow {
    margin-bottom: 1.25rem;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.35em;
    color: rgb(255 255 255 / 0.7);
  }
  .hero-title {
    max-width: 48rem;
    font-family: var(--font-condensed);
    font-size: 4.5rem;
    font-weight: 900;
    text-transform: uppercase;
    line-height: 0.84;
    letter-spacing: -0.035em;
  }
  .hero-actions {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .hero-cta {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.75rem;
    background: #fff;
    color: #000;
    padding: 1rem 1.5rem;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .hero-cta:hover {
    background: var(--red);
    color: #fff;
  }
  .hero-count {
    font-size: 14px;
    color: rgb(255 255 255 / 0.65);
  }

  @media (min-width: 640px) {
    .hero-actions {
      flex-direction: row;
      align-items: center;
    }
  }
  @media (min-width: 768px) {
    .hero-title {
      font-size: 9.5rem;
    }
  }
  @media (min-width: 1024px) {
    .hero-content {
      padding-bottom: 6rem;
    }
  }

  /* Menú */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    background: #000;
    color: #fff;
    padding: 0 var(--gutter) 2.5rem;
    overflow-y: auto;
  }
  .menu[hidden] {
    display: none;
  }
  .menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.75rem;
  }
  .menu-nav {
    display: flex;
    flex-direction: column;
    margin-top: auto;
    margin-bottom: 2.5rem;
  }
  .menu-nav a {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
    font-family: var(--font-condensed);
    font-size: clamp(3rem, 9vw, 6rem);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 1;
    letter-spacing: -0.02em;
    transition: color 0.2s ease;
  }
  .menu-nav a:hover {
    color: var(--red);
  }
  .menu-nav span {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.3em;
    color: var(--red);
  }
</style>

<script>
  const menu = document.getElementById('site-menu');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');

  function setMenu(open: boolean) {
    if (!menu || !openBtn) return;
    menu.hidden = !open;
    openBtn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) menu.querySelector<HTMLElement>('[data-menu-close]')?.focus();
    else openBtn.focus();
  }

  openBtn?.addEventListener('click', () => setMenu(true));
  menu?.querySelector('[data-menu-close]')?.addEventListener('click', () => setMenu(false));
  menu?.querySelectorAll('[data-menu-link]').forEach((link) =>
    link.addEventListener('click', () => {
      if (!menu) return;
      menu.hidden = true;
      openBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }),
  );
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) setMenu(false);
  });
</script>
