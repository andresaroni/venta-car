---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { whatsappLink } from '../data/site';
import {
  type Car,
  statusLabel,
  formatPrice,
  formatNumber,
  carWhatsappMessage,
} from '../data/cars';

interface Props {
  car: Car;
}
const { car } = Astro.props;
const name = `${car.make} ${car.model}`;
const search = `${car.make} ${car.model} ${car.year} ${car.color}`.toLowerCase();
---

<article class="car" data-car={car.id} data-make={car.make} data-price={car.price} data-search={search}>
  <div class="car-media">
    <div class="carousel car-carousel" data-carousel>
      <div class="carousel-track" data-track>
        {
          car.images.length ? (
            car.images.map((src, i) => (
              <div class="slide">
                <img src={src} alt={`${name} — photo ${i + 1}`} loading="lazy" decoding="async" />
              </div>
            ))
          ) : (
            <div class="slide slide-empty">Photos coming soon</div>
          )
        }
      </div>
      <button type="button" class="carousel-arrow" data-prev aria-label="Previous image">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
      </button>
      <button type="button" class="carousel-arrow" data-next aria-label="Next image">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
      </button>
      <div class="carousel-dots" data-dots></div>
    </div>
    <div class={`car-badge is-${car.status}`}>{statusLabel[car.status]}</div>
    <div class="car-price">{formatPrice(car.price)}</div>
  </div>

  <button type="button" class="car-info" data-open-car={car.id} aria-label={`View details: ${name}`}>
    <div>
      <p class="car-meta">{car.year} · {formatNumber(car.mileage)} miles</p>
      <h3 class="car-title">{car.make} <span class="text-red">{car.model}</span></h3>
      <p class="car-sub">{[car.color, car.vin && `VIN ${car.vin}`].filter(Boolean).join(' · ') || ' '}</p>
    </div>
    <svg class="car-arrow" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
  </button>

  <a class="btn-wa car-wa" href={whatsappLink(carWhatsappMessage(car))} target="_blank" rel="noopener">
    <WhatsAppIcon /> Buy on WhatsApp
  </a>
</article>

<style>
  .car {
    display: flex;
    flex-direction: column;
  }
  .car[hidden] {
    display: none;
  }
  .car-media {
    position: relative;
    aspect-ratio: 4 / 3;
  }
  .car-carousel {
    position: absolute;
    inset: 0;
    cursor: pointer;
  }
  .car-carousel :global(.slide img) {
    transition: transform 0.7s ease;
  }
  .car:hover .car-carousel :global(.slide img) {
    transform: scale(1.05);
  }
  .car-badge {
    position: absolute;
    left: 1rem;
    top: 1rem;
    z-index: 3;
    background: #fff;
    padding: 0.5rem 0.75rem;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    pointer-events: none;
  }
  .car-badge.is-reserved {
    background: #f2b33d;
  }
  .car-badge.is-sold {
    background: var(--red);
    color: #fff;
  }
  .car-price {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 3;
    background: rgb(0 0 0 / 0.75);
    color: #fff;
    padding: 0.5rem 0.75rem;
    font-size: 12px;
    font-weight: 600;
    pointer-events: none;
  }
  .car-info {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding-block: 1.25rem;
    border-bottom: 1px solid rgb(0 0 0 / 0.15);
    text-align: left;
  }
  .car-meta {
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: rgb(0 0 0 / 0.45);
  }
  .car-title {
    margin-top: 0.5rem;
    font-family: var(--font-condensed);
    font-size: 1.875rem;
    line-height: 2.25rem;
    font-weight: 700;
    text-transform: uppercase;
  }
  .car-sub {
    margin-top: 0.5rem;
    font-size: 12px;
    color: rgb(0 0 0 / 0.5);
  }
  .car-arrow {
    flex-shrink: 0;
    margin-top: 0.25rem;
    color: rgb(0 0 0 / 0.35);
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .car-info:hover .car-arrow {
    color: var(--red);
    transform: translate(2px, -2px);
  }
  .car-wa {
    margin-top: 1rem;
    width: 100%;
  }
</style>
