---
import { site } from '../data/site';
---

<div class="logo">
  <div class="logo-mark"><span>V</span></div>
  <div class="logo-text">
    <div class="logo-name">{site.name.toUpperCase()}</div>
    <div class="logo-tag">{site.tagline.toUpperCase()}</div>
  </div>
</div>

<style>
  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #fff;
  }
  .logo-mark {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid;
    transform: skew(-12deg);
  }
  .logo-mark::before {
    content: '';
    position: absolute;
    inset: 4px;
    border: 1px solid;
    opacity: 0.35;
  }
  .logo-mark span {
    font-family: var(--font-condensed);
    font-size: 20px;
    font-weight: 900;
    transform: skew(12deg);
  }
  .logo-text {
    line-height: 1;
  }
  .logo-name {
    font-family: var(--font-condensed);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.18em;
  }
  .logo-tag {
    margin-top: 0.25rem;
    font-size: 8px;
    letter-spacing: 0.38em;
    opacity: 0.6;
  }
</style>
